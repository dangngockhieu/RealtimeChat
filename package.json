  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "25.9.1",
    "nodemon": "3.1.14",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
